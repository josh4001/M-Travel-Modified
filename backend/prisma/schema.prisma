// M-TRAVEL — normalized PostgreSQL schema, designed to run on Supabase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  TRAVELER
  TOURIST
  DRIVER
  VEHICLE_OWNER
  BUS_COMPANY
  TOUR_OPERATOR
  HOME_OWNER
  ADMIN
  SUPER_ADMIN
}

enum VehicleType {
  CAR
  SUV
  VAN
  PICKUP
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
}

enum TransmissionType {
  MANUAL
  AUTOMATIC
}

enum BookingStatus {
  PENDING
  ACCEPTED
  DRIVER_ASSIGNED
  DRIVER_ARRIVED
  REJECTED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BookableType {
  VEHICLE
  BUS_SEAT
  TOUR
  HOLIDAY_HOME
}

enum PaymentProvider {
  MPESA
  STRIPE
  PAYPAL
  WALLET
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum TransactionType {
  TOPUP
  BOOKING_PAYOUT
  WITHDRAWAL
  COMMISSION
  REFUND
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum NotificationChannel {
  PUSH
  SMS
  EMAIL
  IN_APP
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// ---------- Core: Users & Roles ----------

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  phone           String?  @unique
  passwordHash    String   @map("password_hash")
  firstName       String   @map("first_name")
  lastName        String   @map("last_name")
  avatarUrl       String?  @map("avatar_url")
  role            Role     @default(TRAVELER)
  isEmailVerified Boolean  @default(false) @map("is_email_verified")
  isPhoneVerified Boolean  @default(false) @map("is_phone_verified")
  isTwoFactorOn   Boolean  @default(false) @map("is_two_factor_on")
  twoFactorSecret String?  @map("two_factor_secret")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  vehicles       Vehicle[]
  bookingsAsUser Booking[]            @relation("BookingUser")
  wallet         Wallet?
  reviewsGiven   Review[]             @relation("ReviewAuthor")
  notifications  Notification[]
  supportTickets SupportTicket[]
  favorites      Favorite[]
  auditLogs      AuditLog[]
  deviceLogins   DeviceLogin[]
  busCompany     BusCompany?
  tourOperator   TourOperatorProfile?
  holidayHomes   HolidayHome[]
  refreshTokens  RefreshToken[]

  @@index([role])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model DeviceLogin {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress  String   @map("ip_address")
  userAgent  String   @map("user_agent")
  location   String?
  loggedInAt DateTime @default(now()) @map("logged_in_at")

  @@index([userId])
  @@map("device_logins")
}

// ---------- Vehicles ----------

model Vehicle {
  id            String           @id @default(uuid())
  ownerId       String           @map("owner_id")
  owner         User             @relation(fields: [ownerId], references: [id])
  type          VehicleType
  make          String
  model         String
  year          Int
  seats         Int
  fuelType      FuelType         @map("fuel_type")
  transmission  TransmissionType
  pricePerDay   Decimal          @map("price_per_day") @db.Decimal(10, 2)
  pricePerKm    Decimal?         @map("price_per_km") @db.Decimal(10, 2)
  plateNumber   String?          @unique @map("plate_number")
  hasInsurance  Boolean          @default(false) @map("has_insurance")
  isStolen      Boolean          @default(false) @map("is_stolen")
  isSelfDriveAvailable Boolean   @default(true) @map("is_self_drive_available")
  isWithDriverAvailable Boolean  @default(true) @map("is_with_driver_available")
  driverId      String?          @map("driver_id")
  latitude      Float
  longitude     Float
  address       String?
  isAvailable   Boolean          @default(true) @map("is_available")
  isApproved    Boolean          @default(true) @map("is_approved")
  ratingAverage Float            @default(0) @map("rating_average")
  ratingCount   Int              @default(0) @map("rating_count")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  images       VehicleImage[]
  bookings     Booking[]
  reviews      Review[]
  availability VehicleAvailability[]
  favorites    Favorite[]
  alerts       VehicleAlert[]

  @@index([type])
  @@index([ownerId])
  @@index([plateNumber])
  @@map("vehicles")
}

model VehicleAlert {
  id          String    @id @default(uuid())
  vehicleId   String    @map("vehicle_id")
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id])
  type        String    @default("STOLEN") // STOLEN | MISSING | RECOVERED
  description String?
  reportedAt  DateTime  @default(now()) @map("reported_at")
  resolvedAt  DateTime? @map("resolved_at")
  isResolved  Boolean   @default(false) @map("is_resolved")

  @@index([vehicleId])
  @@map("vehicle_alerts")
}

model VehicleImage {
  id        String   @id @default(uuid())
  vehicleId String   @map("vehicle_id")
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  url       String
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([vehicleId])
  @@map("vehicle_images")
}

model VehicleAvailability {
  id        String   @id @default(uuid())
  vehicleId String   @map("vehicle_id")
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date      DateTime
  isBlocked Boolean  @default(false) @map("is_blocked")

  @@unique([vehicleId, date])
  @@map("vehicle_availability")
}

// ---------- Bookings ----------

model Booking {
  id             String        @id @default(uuid())
  bookingRef     String        @unique @map("booking_ref")
  userId         String        @map("user_id")
  user           User          @relation("BookingUser", fields: [userId], references: [id])
  bookableType   BookableType  @map("bookable_type")
  vehicleId      String?       @map("vehicle_id")
  vehicle        Vehicle?      @relation(fields: [vehicleId], references: [id])
  driverId       String?       @map("driver_id")
  pickupMethod   String        @default("DRIVER_DELIVER") @map("pickup_method")
  pickupLat      Float?        @map("pickup_lat")
  pickupLng      Float?        @map("pickup_lng")
  destinationLat Float?        @map("destination_lat")
  destinationLng Float?        @map("destination_lng")
  startDate      DateTime      @map("start_date")
  endDate        DateTime      @map("end_date")
  totalAmount    Decimal       @map("total_amount") @db.Decimal(10, 2)
  currency       String        @default("KES")
  status         BookingStatus @default(PENDING)
  qrCode         String?       @map("qr_code")
  cancelReason   String?       @map("cancel_reason")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  payment Payment?
  review  Review?

  @@index([userId])
  @@index([vehicleId])
  @@index([status])
  @@map("bookings")
}

// ---------- Real-Time GPS Telemetry & History ----------

model DriverLiveLocation {
  id           String   @id @default(uuid())
  driverId     String   @map("driver_id")
  tripId       String   @map("trip_id")
  vehicleId    String   @map("vehicle_id")
  latitude     Float
  longitude    Float
  speed        Float    @default(0)
  heading      Float    @default(0)
  accuracy     Float    @default(5)
  status       String   @default("AVAILABLE")
  batteryLevel Int?     @map("battery_level")
  recordedAt   DateTime @default(now()) @map("recorded_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([driverId, tripId])
  @@map("driver_live_locations")
}

model TripHistory {
  id             String   @id @default(uuid())
  tripId         String   @map("trip_id")
  latitude       Float
  longitude      Float
  speed          Float    @default(0)
  heading        Float    @default(0)
  sequenceNumber Int      @map("sequence_number")
  recordedAt     DateTime @default(now()) @map("recorded_at")

  @@index([tripId])
  @@map("trip_history")
}

// ---------- Payments & Wallet ----------

model Payment {
  id          String          @id @default(uuid())
  bookingId   String          @unique @map("booking_id")
  booking     Booking         @relation(fields: [bookingId], references: [id])
  provider    PaymentProvider
  amount      Decimal         @db.Decimal(10, 2)
  currency    String          @default("KES")
  status      PaymentStatus   @default(PENDING)
  providerRef String?         @map("provider_ref")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@map("payments")
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  currency  String   @default("KES")
  updatedAt DateTime @updatedAt @map("updated_at")

  transactions Transaction[]

  @@map("wallets")
}

model Transaction {
  id          String            @id @default(uuid())
  walletId    String            @map("wallet_id")
  wallet      Wallet            @relation(fields: [walletId], references: [id])
  type        TransactionType
  amount      Decimal           @db.Decimal(12, 2)
  status      TransactionStatus @default(PENDING)
  reference   String?
  description String?
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([walletId])
  @@map("transactions")
}

// ---------- Reviews ----------

model Review {
  id        String   @id @default(uuid())
  authorId  String   @map("author_id")
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  vehicleId String?  @map("vehicle_id")
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
  bookingId String?  @unique @map("booking_id")
  booking   Booking? @relation(fields: [bookingId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([vehicleId])
  @@map("reviews")
}

// ---------- Buses ----------

model BusCompany {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  buses  Bus[]
  routes Route[]

  @@map("bus_companies")
}

model Bus {
  id          String     @id @default(uuid())
  companyId   String     @map("company_id")
  company     BusCompany @relation(fields: [companyId], references: [id])
  plateNumber String     @unique @map("plate_number")
  totalSeats  Int        @map("total_seats")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@map("buses")
}

model Route {
  id          String     @id @default(uuid())
  companyId   String     @map("company_id")
  company     BusCompany @relation(fields: [companyId], references: [id])
  origin      String
  destination String
  departureAt DateTime   @map("departure_at")
  price       Decimal    @db.Decimal(10, 2)
  createdAt   DateTime   @default(now()) @map("created_at")

  @@map("routes")
}

// ---------- Tours ----------

model TourOperatorProfile {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  bio       String?
  createdAt DateTime @default(now()) @map("created_at")

  tours Tour[]

  @@map("tour_operator_profiles")
}

model Tour {
  id           String              @id @default(uuid())
  operatorId   String              @map("operator_id")
  operator     TourOperatorProfile @relation(fields: [operatorId], references: [id])
  title        String
  category     String
  description  String
  price        Decimal             @db.Decimal(10, 2)
  durationDays Int                 @map("duration_days")
  createdAt    DateTime            @default(now()) @map("created_at")

  @@map("tours")
}

// ---------- Holiday Homes ----------

model HolidayHome {
  id            String   @id @default(uuid())
  ownerId       String   @map("owner_id")
  owner         User     @relation(fields: [ownerId], references: [id])
  title         String
  county        String
  bedrooms      Int
  guests        Int
  pricePerNight Decimal  @map("price_per_night") @db.Decimal(10, 2)
  latitude      Float
  longitude     Float
  amenities     String[]
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("holiday_homes")
}

// ---------- Cross-cutting ----------

model Favorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  vehicleId String?  @map("vehicle_id")
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, vehicleId])
  @@map("favorites")
}

model Notification {
  id        String              @id @default(uuid())
  userId    String              @map("user_id")
  user      User                @relation(fields: [userId], references: [id])
  channel   NotificationChannel
  title     String
  body      String
  isRead    Boolean             @default(false) @map("is_read")
  createdAt DateTime            @default(now()) @map("created_at")

  @@index([userId])
  @@map("notifications")
}

model SupportTicket {
  id        String              @id @default(uuid())
  userId    String              @map("user_id")
  user      User                @relation(fields: [userId], references: [id])
  subject   String
  message   String
  status    SupportTicketStatus @default(OPEN)
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  @@map("support_tickets")
}

model Coupon {
  id             String    @id @default(uuid())
  code           String    @unique
  discountPct    Int       @map("discount_pct")
  maxRedemptions Int?      @map("max_redemptions")
  redeemedCount  Int       @default(0) @map("redeemed_count")
  expiresAt      DateTime? @map("expires_at")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("coupons")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  metadata  Json?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([entity])
  @@map("audit_logs")
}
